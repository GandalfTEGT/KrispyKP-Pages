{
  "siteId": "krispykp",
  "schemaVersion": 1,
  "protocolVersion": 2,
  "adapter": "static-pages-v2",
  "requiredCapabilities": [
    "pages.compose.v1",
    "pages.routes.v1",
    "pages.shell.v1",
    "snapshot.validation.v1",
    "pages.image-media.v2"
  ],
  "registryFile": "data/site-pages.json",
  "styleFile": "styles/site-pages.generated.css",
  "templates": [
    "blank",
    "standard"
  ],
  "components": [
    "heading",
    "text",
    "button",
    "image",
    "panel",
    "grid"
  ],
  "maxPages": 20,
  "maxNodes": 80,
  "maxDepth": 5
}
